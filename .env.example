# Copy to .env (or set in the Scheduled Task environment). NEVER commit real keys.

# --- API keys (read from env; never hardcoded) ---
FRED_API_KEY=your_fred_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# --- Transport ---
# stdio (default, local/dev) | http (remote connector via Cloudflare Tunnel)
MCP_TRANSPORT=http
# HOST: keep on loopback; cloudflared fronts it. No inline comments on value
# lines — the .env loaders take everything after '=' as the value.
HOST=127.0.0.1
PORT=8790

# --- Remote-connector OAuth (only for the Claude.ai connector) ---
# Set MCP_AUTH=oauth to turn the server into an OAuth 2.1 AS (DCR + PKCE).
# PUBLIC_URL MUST equal the public https origin or strict clients reject the
# issuer (playbook section 1).
MCP_AUTH=oauth
PUBLIC_URL=https://market.popcult.win

# --- Outbound proxy (deploy host) ---
# This host reaches FRED/Finnhub only through the local proxy, while the China
# data hosts (eastmoney/sina/CFETS/chinamoney/legu) must stay DIRECT. The
# libraries read these from the environment; the launcher loads them from here.
# Set to your proxy's HTTP port (e.g. V2Ray 10808/10809, Clash 7890).
HTTPS_PROXY=http://127.0.0.1:10808
HTTP_PROXY=http://127.0.0.1:10808
NO_PROXY=eastmoney.com,sinajs.cn,sina.com.cn,sse.com.cn,szse.cn,cfets.com.cn,chinamoney.com.cn,gtimg.cn,legulegu.com,localhost,127.0.0.1

# --- Logging ---
LOG_LEVEL=INFO
